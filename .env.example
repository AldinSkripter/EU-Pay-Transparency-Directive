# Without DATABASE_URL the application runs an isolated, ephemeral demo.
PORT=3000
HOST=127.0.0.1
# DATABASE_URL=postgresql://pay_app:CHANGE_ME@127.0.0.1:5432/pay_transparency
# Required with PostgreSQL. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PSEUDONYM_SECRET=
# Required for owner accounts/settings with PostgreSQL or production.
# Generate a separate random 32-byte hex key; keep outside the database and Git.
# ADMIN_ENCRYPTION_KEY=
# Exact Equitensa host allowlist, including explicit www aliases and local development.
MARKET_DE_HOSTS=equitensa.de,www.equitensa.de,localhost,127.0.0.1
MARKET_AT_HOSTS=equitensa.at,www.equitensa.at,localhost.at
MARKET_SI_HOSTS=equitensa.si,www.equitensa.si,localhost.si
# Required when using PostgreSQL. Used to reject cross-origin mutations.
APP_ORIGINS=https://equitensa.de,https://www.equitensa.de,https://equitensa.at,https://www.equitensa.at,https://equitensa.si,https://www.equitensa.si,http://localhost:3000,http://127.0.0.1:3000
# PDF font with German and Slovenian glyphs. Arial / DejaVu are auto-detected.
# PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Stripe: optional in development; required to take actual payments.
# Configure six EUR recurring prices matching the public price table.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BILLING_ORIGIN=https://equitensa.de
# STRIPE_PRICE_PREPARE_MONTHLY=
# STRIPE_PRICE_PREPARE_ANNUAL=
# STRIPE_PRICE_GROWTH_MONTHLY=
# STRIPE_PRICE_GROWTH_ANNUAL=
# STRIPE_PRICE_SCALE_MONTHLY=
# STRIPE_PRICE_SCALE_ANNUAL=
